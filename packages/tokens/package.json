{
  "name": "@kaladan/diba-tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "Diba design tokens — one OKLCH source compiled to CSS variables, a Tailwind v4 theme layer, TS types, and a Flutter Material 3 theme.",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-tokens",
    "oklch",
    "tailwind",
    "style-dictionary",
    "rtl",
    "persian",
    "kaladan",
    "diba"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0",
    "vitest": "3.2.7"
  }
}
