{
  "name": "ProgressCircle",
  "category": "feedback",
  "description": "How far along something is, as a ring: a profile's completion. Display only, so one value and no pair.",
  "sduiSafe": true,
  "props": {
    "value": {
      "type": "number"
    },
    "minValue": {
      "type": "number",
      "default": 0
    },
    "maxValue": {
      "type": "number",
      "default": 100
    },
    "isIndeterminate": {
      "type": "boolean",
      "default": false,
      "description": "Waiting on the server."
    },
    "label": {
      "type": "string",
      "i18n": true,
      "description": "Names it for a screen reader; it is not drawn."
    },
    "color": {
      "type": "enum",
      "values": [
        "default",
        "accent",
        "success",
        "warning",
        "danger"
      ],
      "default": "accent"
    },
    "size": {
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    }
  }
}
