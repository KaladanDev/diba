{
  "name": "LinkButton",
  "category": "navigation",
  "description": "A link drawn as a Button. The host navigates, and is told when the link is external.",
  "sduiSafe": true,
  "props": {
    "variant": {
      "type": "enum",
      "values": ["primary", "secondary", "tertiary", "outline", "ghost", "danger", "danger-soft"],
      "default": "secondary"
    },
    "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "sm" },
    "icon": { "type": "token", "token": "icon", "description": "A name from the icon list." },
    "iconPlacement": {
      "type": "enum",
      "values": ["start", "end"],
      "default": "start",
      "description": "Mirrored in right-to-left."
    },
    "isIconOnly": {
      "type": "boolean",
      "default": false,
      "description": "Draws the icon alone; label then names the button."
    },
    "label": {
      "type": "string",
      "i18n": true,
      "description": "The accessible name and tooltip. Required when isIconOnly."
    },
    "isDisabled": { "type": "boolean", "default": false },
    "fullWidth": { "type": "boolean", "default": false },
    "href": { "type": "string", "format": "url", "description": "A URL, held to isSafeUrl." },
    "isExternal": {
      "type": "boolean",
      "default": false,
      "description": "Leaves the admin; the host decides how."
    }
  },
  "children": { "accepts": "text", "description": "The link's text (localizable)." },
  "actions": {
    "onPress": { "description": "Fires before the host navigates.", "payload": "PressEvent" }
  }
}
