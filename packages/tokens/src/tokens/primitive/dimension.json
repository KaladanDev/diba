    "xl":   { "$type": "dimension", "$value": "20px" },
    "2xl":  { "$type": "dimension", "$value": "28px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },

  "border-width": {
    "sm": { "$type": "dimension", "$value": "1px" },
    "md": { "$type": "dimension", "$value": "2px" },
    "lg": { "$type": "dimension", "$value": "3px" }
  },

  "divider": {
    "weight": { "$type": "dimension", "$value": "1px" }
  },

  "focus": {
    "width":  { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  }
