{
  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": "0px 1px 2px 0px oklch(0.235 0.03 285 / 0.05)",
      "$extensions": { "diba": { "dark": "0px 1px 2px 0px oklch(0 0 0 / 0.2)" } }
    },
    "sm": {
      "$type": "shadow",
      "$value": "0px 0px 5px 0px oklch(0.235 0.03 285 / 0.02), 0px 2px 10px 0px oklch(0.235 0.03 285 / 0.06), 0px 0px 1px 0px oklch(0.235 0.03 285 / 0.3)",
      "$extensions": { "diba": { "dark": "0px 0px 5px 0px oklch(0 0 0 / 0.05), 0px 2px 10px 0px oklch(0 0 0 / 0.2), inset 0px 0px 1px 0px oklch(1 0 0 / 0.15)" } }
    },
    "md": {
      "$type": "shadow",
      "$value": "0px 0px 15px 0px oklch(0.235 0.03 285 / 0.03), 0px 2px 30px 0px oklch(0.235 0.03 285 / 0.08), 0px 0px 1px 0px oklch(0.235 0.03 285 / 0.3)",
      "$extensions": { "diba": { "dark": "0px 0px 15px 0px oklch(0 0 0 / 0.06), 0px 2px 30px 0px oklch(0 0 0 / 0.22), inset 0px 0px 1px 0px oklch(1 0 0 / 0.15)" } }
    },
    "lg": {
      "$type": "shadow",
      "$value": "0px 0px 30px 0px oklch(0.235 0.03 285 / 0.04), 0px 30px 60px 0px oklch(0.235 0.03 285 / 0.12), 0px 0px 1px 0px oklch(0.235 0.03 285 / 0.3)",
      "$extensions": { "diba": { "dark": "0px 0px 30px 0px oklch(0 0 0 / 0.07), 0px 30px 60px 0px oklch(0 0 0 / 0.26), inset 0px 0px 1px 0px oklch(1 0 0 / 0.15)" } }
    }
  },

  "hover": {
    "opacity": {
      "$type": "number",
      "$value": "0.8",
      "$extensions": { "diba": { "dark": "0.9" } }
    }
  }
}
