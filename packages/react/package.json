{
  "name": "@kaladan/diba-react",
  "version": "0.0.0",
  "type": "module",
  "description": "Diba React components — React Aria + Tailwind v4, token-driven, RTL/FA-first.",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "react-aria",
    "tailwindcss",
    "rtl",
    "persian",
    "accessibility",
    "sdui",
    "kaladan",
    "diba"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/**/*.mdx",
    "!src/test",
    "!src/stories",
    "!src/foundations",
    "!src/patterns",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.css": "./src/styles/index.css",
    "./variants": {
      "types": "./dist/variants.d.ts",
      "import": "./dist/variants.js"
    },
    "./package.json": "./package.json",
    "./sdui": {
      "types": "./dist/sdui/index.d.ts",
      "import": "./dist/sdui/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "shots": "node scripts/shots.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@kaladan/diba-schema": "workspace:^",
    "@kaladan/diba-tokens": "workspace:^",
    "@radix-ui/react-avatar": "^1.2.6",
    "@react-aria/utils": "^3.34.1",
    "@react-types/shared": "^3.36.1",
    "clsx": "^2.1.1",
    "input-otp": "1.5.0",
    "lucide-react": "1.55.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "3.2.7",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "vite": "^6.0.0",
    "vitest": "3.2.7"
  }
}
