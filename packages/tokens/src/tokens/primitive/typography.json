{
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "fa":   { "$type": "fontFamily", "$value": "'Yekan Bakh', Vazirmatn, Inter, ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, 'SF Mono', 'Cascadia Code', 'Fira Code', monospace" }
    }
  },
  "text": {
    "xs":  { "$type": "dimension", "$value": "0.75rem" },
    "sm":  { "$type": "dimension", "$value": "0.875rem" },
    "md":  { "$type": "dimension", "$value": "1rem" },
    "lg":  { "$type": "dimension", "$value": "1.125rem" },
    "xl":  { "$type": "dimension", "$value": "1.25rem" },
    "2xl": { "$type": "dimension", "$value": "1.5rem" },
    "3xl": { "$type": "dimension", "$value": "1.875rem" },
    "4xl": { "$type": "dimension", "$value": "2.25rem" },
    "5xl": { "$type": "dimension", "$value": "3rem" }
  },
  "weight": {
    "normal":   { "$type": "fontWeight", "$value": "400" },
    "medium":   { "$type": "fontWeight", "$value": "500" },
    "semibold": { "$type": "fontWeight", "$value": "600" },
    "bold":     { "$type": "fontWeight", "$value": "700" }
  },
  "leading": {
    "tight":   { "$type": "number", "$value": "1.2" },
    "snug":    { "$type": "number", "$value": "1.35" },
    "normal":  { "$type": "number", "$value": "1.5" },
    "relaxed": { "$type": "number", "$value": "1.65" }
  },
  "tracking": {
    "tight":  { "$type": "dimension", "$value": "-0.02em" },
    "normal": { "$type": "dimension", "$value": "0em" },
    "wide":   { "$type": "dimension", "$value": "0.02em" }
  }
}
